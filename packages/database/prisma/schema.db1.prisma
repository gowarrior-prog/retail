datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-db1"
}

enum Role {
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  orders    Order[]

  @@map("users")
}

model Product {
  id           String   @id @default(uuid())
  name         String   @map("name")
  description  String?
  price        Float
  costPrice    Float    @default(0.0) @map("cost_price")
  profitMargin Float    @default(0.0) @map("profit_margin")
  stock        Int      @default(0)
  sku          String?  @map("sku")
  barcode      String?  @map("barcode")
  category     String?  @default("General")
  imageUrl     String?  @map("image_url")
  odooId       Int?     @map("odoo_id")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("products")
}

enum OrderType {
  ONLINE
  POS_COUNTER
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid())
  totalAmount   Float       @map("total_amount")
  type          OrderType   @default(POS_COUNTER)
  status        OrderStatus @default(COMPLETED)
  
  userId        String?     @map("user_id")
  user          User?       @relation(fields: [userId], references: [id])
  
  itemsJson     String      @map("items_json")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("orders")
}
