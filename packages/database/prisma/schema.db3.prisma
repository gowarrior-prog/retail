datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-db3"
}

// Deep Historic Billing Records (Archived to keep main app fast)
model BillingHistory {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique @map("invoice_number")
  customerPhone   String?  @map("customer_phone")
  totalAmount     Float    @map("total_amount")
  discount        Float    @default(0)
  tax             Float    @default(0)
  paymentMode     String   @map("payment_mode") // CASH, CARD, KHATA, ONLINE
  cashierName     String?  @map("cashier_name")
  itemDetailsJson String   @map("item_details_json") // Compact JSON snapshot of invoice items

  billingDate     DateTime @default(now()) @map("billing_date")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("billing_history")
}

// Khata (Customer Ledger & Credit/Debit)
model CustomerKhata {
  id           String             @id @default(uuid())
  customerName String             @map("customer_name")
  phone        String             @unique
  totalBalance Float              @default(0) @map("total_balance") // Positive = customer owes shop, Negative = shop owes customer
  
  transactions KhataTransaction[]

  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at")

  @@map("customer_khata")
}

model KhataTransaction {
  id          String        @id @default(uuid())
  khataId     String        @map("khata_id")
  khata       CustomerKhata @relation(fields: [khataId], references: [id], onDelete: Cascade)
  type        String        // DEBIT (Udhari/Gave product), CREDIT (Vasooli/Received Payment)
  amount      Float
  description String?

  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("khata_transactions")
}

// Shop Purchases (Buy from Suppliers / Vendors)
model ShopPurchase {
  id           String   @id @default(uuid())
  supplierName String   @map("supplier_name")
  itemName     String   @map("item_name")
  quantity     Int
  totalCost    Float    @map("total_cost")
  paidAmount   Float    @map("paid_amount")
  remaining    Float    @default(0)
  notes        String?
  purchaseDate DateTime @default(now()) @map("purchase_date")

  createdAt    DateTime @default(now()) @map("created_at")

  @@map("shop_purchases")
}

// Daily Aggregated Sales Analytics
model DailySalesAnalytics {
  id              String   @id @default(uuid())
  date            DateTime @unique
  totalSalesCount Int      @map("total_sales_count")
  totalRevenue    Float    @map("total_revenue")
  totalProfit     Float    @map("total_profit")
  topCategory     String?  @map("top_category")

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("daily_sales_analytics")
}

// Super Admin Audit & Monitoring Logs
model SuperAdminAuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g. "DATA_DELETED", "SUPER_ADMIN_ACCESS", "STORAGE_SWAPPED"
  targetDb    String   @map("target_db") // DB1, DB2, DB3
  performedBy String   @map("performed_by")
  details     String?
  ipAddress   String?  @map("ip_address")

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("super_admin_audit_logs")
}
