datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-db2"
}

enum EmployeeRole {
  MANAGER
  CASHIER
  SALES_EXECUTIVE
  HELPER
  ACCOUNTANT
}

model Employee {
  id               String         @id @default(uuid())
  name             String
  phone            String         @unique
  cnic             String?        @unique
  role             EmployeeRole   @default(SALES_EXECUTIVE)
  baseSalary       Float          @map("base_salary")
  isDeleted        Boolean        @default(false) @map("is_deleted")
  
  // Attendance Tracking (Embedded)
  attendanceStatus String         @default("PRESENT") @map("attendance_status") // PRESENT, ABSENT, LATE, HALF_DAY
  attendanceNotes  String?        @map("attendance_notes")
  lastAttendanceDate DateTime?    @map("last_attendance_date")

  // Leave Tracking (Embedded)
  leaveStatus      String         @default("NONE") @map("leave_status") // NONE, PENDING, APPROVED, REJECTED
  leaveReason      String?        @map("leave_reason")
  leaveStartDate   DateTime?      @map("leave_start_date")
  leaveEndDate     DateTime?      @map("leave_end_date")

  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  salaries         SalaryPayout[]

  @@map("employees")
}

model SalaryPayout {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String   // e.g. "2026-09"
  amountPaid Float    @map("amount_paid")
  bonus      Float    @default(0)
  deductions Float    @default(0)
  paidAt     DateTime @default(now()) @map("paid_at")

  @@map("salary_payouts")
}
